{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"target": "es2023",
		"lib": ["es2023", "esnext.intl"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["index.ts", "src"]
}
